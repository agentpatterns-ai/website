# Explicit response headers for Cloudflare Workers static assets (#6451).
# Served from site/_headers (MkDocs copies this file into the build output).
# Explicit beats dashboard defaults: these survive project moves and are
# reviewable in git.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Material theme assets are content-hashed (assets/stylesheets/main.<hash>.css)
# — safe to cache long and immutably.
/assets/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/javascripts/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed site assets (logo, og images, custom css): cache a day, revalidate.
/assets/*
  Cache-Control: public, max-age=86400
/stylesheets/*
  Cache-Control: public, max-age=86400

# HTML and feeds: short cache so published fixes propagate quickly.
/*.html
  Cache-Control: public, max-age=600
/feed.xml
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
